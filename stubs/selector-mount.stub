import { createApp } from 'vue';
import Selector from '../Pages/CPQ/Selector.vue';

function mountCpqVueApp() {
    const el = document.getElementById('cpq-vue-app');
    
    if (el && !el.__vue_app__) {
        try {
            const rawProps = el.getAttribute('data-props');
            const props = rawProps ? JSON.parse(rawProps) : {};
            
            const app = createApp(Selector, props);
            app.mount(el);
            el.__vue_app__ = app;
        } catch (error) {
            console.error('Failed to mount CPQ Vue App:', error);
        }
    }
}

document.addEventListener('DOMContentLoaded', mountCpqVueApp);
document.addEventListener('livewire:navigated', mountCpqVueApp);

// Run immediately in case the script evaluates after DOMContentLoaded
if (document.readyState !== 'loading') {
    mountCpqVueApp();
}